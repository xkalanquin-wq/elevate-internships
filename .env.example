# Copy to .env and fill in what you have. Every key is optional.

# Adzuna Jobs API: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS API: https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
# USAJOBS requires the email you registered with, sent as the User-Agent
USAJOBS_EMAIL=

# The Muse works without a key. Adding one raises the rate limit.
MUSE_API_KEY=

# Enables the "Suggest more" button (Claude API): https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Deployment ---------------------------------------------------------
# The public origin, used for canonical, og:image and the Twitter card.
# Social crawlers cannot resolve relative paths, so these must be absolute.
# Defaults to https://elevateinternships.com at build time; override only for
# a staging domain or a preview deploy.
# SITE_URL=https://staging.elevateinternships.com

# Set to "production" when deployed. This turns on the HTTPS redirect, HSTS,
# and Secure cookies. Leave unset locally, where there is no certificate.
NODE_ENV=

# Number of proxies in front of the app (Heroku/Fly/Render/nginx = 1).
# Needed so X-Forwarded-Proto is trusted; otherwise the HTTPS redirect loops.
TRUST_PROXY=1

# Only set to false if something in front of you already terminates TLS and
# you are certain the hop to this app is private.
# FORCE_HTTPS=false

# --- Site operator --------------------------------------------------------
# Printed on the privacy page as the address for data requests. Without it the
# policy promises rights with no way to exercise them. Read at runtime, so
# changing it needs a restart, not a rebuild.
CONTACT_EMAIL=

# Take a verified database snapshot this often (hours), into data/backups.
# 0 or unset disables it. On a hosting platform this is the only practical
# schedule — the disk is attached to this one service. See BACKUPS.md.
BACKUP_EVERY_HOURS=24

# Keep the database in Cloudflare Workers KV, for hosts with no persistent disk
# (Render's free plan). Restored on boot, saved within two minutes of a change,
# one daily copy kept 14 days. All three or none. Token permission:
# Account > Workers KV Storage > Edit. Leave blank locally. See DEPLOY.md.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# --- Email (password reset, address confirmation) ------------------------
# Without one of these, reset and confirmation links are PRINTED TO THE SERVER
# CONSOLE instead of sent. That is fine locally and useless in production.
#
# Option A — Resend (simplest): https://resend.com
RESEND_API_KEY=
# Option B — any SMTP host
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true        # set for port 465
MAIL_FROM=Elevate Internships <noreply@elevateinternships.com>

# --- Sign in with Google -------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: https://your-domain/api/auth/google/callback
# Google sign-in stays hidden in the UI until both of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the app sits behind a proxy on a different host than it sees.
# OAUTH_REDIRECT_BASE=https://elevateinternships.com

# --- Payments: Premium ($9.99 a semester) and sponsored listings ($49) ----
# From dashboard.stripe.com > Developers > API keys. Use sk_test_... first.
# Off until set. The webhook secret comes from adding the endpoint
# https://your-domain/api/stripe/webhook with the events
# checkout.session.completed and charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google AdSense ------------------------------------------------------
# ADSENSE_CLIENT alone adds the verification tag and ads.txt. ADSENSE_ADS=on
# also loads the ad script on the guide pages (never the app, never Premium).
ADSENSE_CLIENT=
ADSENSE_ADS=

# --- Daily caps (server/limits.js) -------------------------------------------
# Keep each outside service inside its free allowance or budget. Defaults:
# ADZUNA_DAILY_CAP=240   (Adzuna free tier: 250 requests a day)
# EMAIL_DAILY_CAP=95     (Resend free plan: 100 emails a day; bulk mail stops at 80%)
# SUGGEST_DAILY_CAP=50   ("Suggest more" calls to the paid Claude API)

# --- Notifications ----------------------------------------------------------
# Nothing to set: signing keys are created on first start and kept in the
# database. Set both only to pin them yourself (npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Owner-only server details ------------------------------------------
# Leave blank and Stats is reachable only from this machine (localhost).
# Set a passcode to unlock it from anywhere — required if you deploy this.
OWNER_PASSCODE=
# Optional: fixes the session signing key so sessions survive a restart.
# It also encrypts the notification keys stored in the database (server/seal.js),
# so do not change it once set: people would have to turn notifications on again.
OWNER_SECRET=
# Optional: a separate key for that encryption, if you prefer not to reuse OWNER_SECRET.
# DATA_KEY=

PORT=3001

# The API port, when something else already owns PORT. Takes precedence over
# PORT. In dev the API refuses to take 5173 even if PORT says so, because that
# is Vite's and the two would fight over the socket.
# API_PORT=3001
