{
  "name": "career-launchpad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "//serve": "What a host should run. `start` rebuilds first, which is handy locally but fails on hosts that prune devDependencies (vite is one) before starting. Build at deploy time, then run this.",
    "serve": "node server/index.js",
    "og": "node scripts/make-og-image.js",
    "reset": "node scripts/reset-data.js",
    "report": "node scripts/report.js",
    "backup": "node scripts/backup.js",
    "backup:list": "node scripts/backup.js --list",
    "verify-catalog": "node scripts/verify-catalog.js",
    "check-prices": "node scripts/check-prices.js",
    "contrast": "node scripts/check-contrast.js",
    "icons": "node scripts/make-app-icons.js",
    "backup:download": "node scripts/download-backup.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
