# Dependencies — nested ones too, so this stays unanchored.
node_modules

# Build output. Regenerated by `npm run build` at deploy time.
/dist
# Browser extension packages, from `node scripts/build-extension.js`.
/dist-extension

# Runtime state: the database, the geocode cache, backups, generated reports.
# Anchored with a leading slash on purpose. A bare `data` would also match
# server/data/, which is shipped CONTENT, not state — the certification
# catalog, the track definitions and the US ZIP tables all live there. Ignoring
# those would deploy a site with an empty catalog and no working radius search.
/data

# Secrets, anywhere.
.env
.env.*
!.env.example

# Third-party skill packs downloaded into the workspace. Not part of this app,
# 4.3MB across 174 files, and some of their paths exceed the Windows limit,
# which aborts `git add` outright. The dev-server config beside them is ours
# and is kept.
.claude/skills/

# OS and editor noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Paid content. The Recruiting Kit is sold with Premium and served only to
# members from server/private; a working copy of any of its files must never
# be committed where the public repository would give it away.
/store/recruiting-kit/

# One-off screenshots taken in the project root while testing.
/shot-*.png

# Paid Recruiting Kit is kept out of the public repo.
/server/private/
/scripts/kit/
